# backend/.env
# IMPORTANT: Never share or commit this file. It is listed in .gitignore.

# MongoDB — points to your local instance, database named "chessjourney"
MONGO_URI=mongodb://127.0.0.1:27017/chessjourney

# Secret key used to sign JWT tokens — change this in production
JWT_SECRET=chessjourney_super_secret_key_change_this

# Express server port
PORT=5000
